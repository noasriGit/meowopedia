# Copy to .env.local and fill in values.

# Canonical site URL (must match production host, including www)
NEXT_PUBLIC_SITE_URL=https://www.meowopedia.com

# Optional image sourcing (existing scripts)
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=

# GitHub Actions only — Cursor draft automation webhook (Settings → Secrets → Actions)
# CURSOR_DRAFT_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/...
# CURSOR_DRAFT_WEBHOOK_TOKEN=crsr_...   (from Automations → Generate auth header)
